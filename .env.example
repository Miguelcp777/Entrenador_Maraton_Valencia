# Copia este archivo a .env.local y rellena los valores reales.
# .env.local está en .gitignore (*.local) y NO se versiona.

# Supabase
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Strava OAuth — crea/gestiona la app en https://www.strava.com/settings/api
# NOTA: al ser variables VITE_ se incluyen en el bundle del cliente; no son
# secretas frente a un usuario avanzado. Para un secret realmente privado,
# muévelo a una Supabase Edge Function.
VITE_STRAVA_CLIENT_ID=tu_client_id
VITE_STRAVA_CLIENT_SECRET=tu_client_secret
